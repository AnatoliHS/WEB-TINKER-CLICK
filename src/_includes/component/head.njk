<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or "Tinker Click — Make your own apps by describing them" }}</title>

  <meta name="description" content="{{ description or 'Tinker Click turns what you describe into small apps you can play, remix and share. Join the waitlist for early access.' }}" />
  <meta name="keywords" content="Tinker Click, make your own apps, AI app maker, remix apps, app gallery, offline apps, creative playground, tinker app, tinker.click" />
  <meta name="author" content="Tinker Click" />
  <meta name="robots" content="{{ 'noindex, nofollow' if noindex else 'index, follow' }}" />

  <!-- Canonical URL -->
  <link rel="canonical" href="https://tinker.click{{ page.url }}" />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://tinker.click{{ page.url }}" />
  <meta property="og:title" content="{{ title or 'Tinker Click — Make your own apps by describing them' }}" />
  <meta property="og:description" content="{{ description or 'Tinker Click turns what you describe into small apps you can play, remix and share. Join the waitlist for early access.' }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <!-- The share picture: design/social-card.html, rendered by design/render-social.cjs -->
  <meta property="og:image" content="{{ site.url }}{{ socialImage or site.socialImage }}" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ socialImageAlt or site.socialImageAlt }}" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://tinker.click{{ page.url }}" />
  <meta name="twitter:title" content="{{ title or 'Tinker Click — Make your own apps by describing them' }}" />
  <meta name="twitter:description" content="{{ description or 'Tinker Click turns what you describe into small apps you can play, remix and share. Join the waitlist for early access.' }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ socialImage or site.socialImage }}" />
  <meta name="twitter:image:alt" content="{{ socialImageAlt or site.socialImageAlt }}" />

  <!-- Structured Data: SoftwareApplication -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Tinker Click",
    "operatingSystem": "Windows, macOS, Linux, iPadOS",
    "description": "Tinker Click is an open-source app for making focused apps, games, documents, charts and dashboards by describing them, with a public gallery to discover, remix and share them.",
    "url": "https://tinker.click"
  }
  </script>

  <!-- Flags JS, and the intro when the layout asks for it (data-intro on <html>), before the page paints -->
  <script src="/assets/js/early.js"></script>

  <!-- Fonts, served from the site: Anton (wordmark only), Geist (everything else). The Latin files load first -->
  <link rel="preload" href="/assets/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">

  <!-- Core Stylesheet -->
  <link rel="stylesheet" href="/assets/css/style.css">
  <!-- Written by the build from every style="" attribute (src/_plugins/eleventy-plugin-csp.js) -->
  <link rel="stylesheet" href="/assets/css/inline.css">

  <!-- Favicons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0e0e0f" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#eee9e2" media="(prefers-color-scheme: light)">
</head>